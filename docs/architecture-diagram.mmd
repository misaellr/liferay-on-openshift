graph TB
    subgraph Internet
        Users["👤 Users (HTTPS)"]
    end

    subgraph OCP["OpenShift 4.x Cluster"]
        subgraph Router["OpenShift Router"]
            Route["Route: liferay-default<br/>TLS Edge Termination<br/>*.apps.cluster.domain"]
        end

        subgraph AppLayer["Application Layer (liferay-dev namespace)"]
            LR["Liferay DXP<br/>StatefulSet<br/>UID 1000 | nonroot-v2 SCC"]
            InitC["Init Containers:<br/>① prepopulate-data<br/>② install-opensearch-modules<br/>③ overlay<br/>④ wait-on-services"]
            CM["ConfigMap<br/>portal properties<br/>OSGi configs"]
            Svc["Service :8080"]
            PVC_LR["PVC: 20Gi<br/>gp3-csi / managed-csi"]
        end

        subgraph DataLayer["Data Layer (same namespace)"]
            PG["PostgreSQL 16<br/>Crunchy PGO<br/>Secret: pgdb-pguser-liferay"]
            OS["OpenSearch 2.19<br/>Direct StatefulSet<br/>Security disabled"]
            PVC_PG["PVC: 10Gi"]
            PVC_OS["PVC: 10Gi"]
        end

        subgraph GitOps["GitOps (openshift-gitops namespace)"]
            Argo["ArgoCD<br/>OpenShift GitOps Operator"]
            AppSet["ApplicationSet<br/>Git Generator"]
        end
    end

    subgraph External["External"]
        GH["GitHub Repo<br/>values/environments/*/liferay.yaml"]
        OCI["OCI Registry<br/>liferay-default chart"]
        Releases["releases.liferay.com<br/>OpenSearch modules"]
    end

    Users --> Route
    Route --> Svc
    Svc --> LR
    InitC --> LR
    CM --> LR
    LR --> PG
    LR --> OS
    PG --> PVC_PG
    OS --> PVC_OS
    LR --> PVC_LR
    AppSet --> GH
    AppSet --> OCI
    Argo --> LR
    InitC -.-> Releases

    classDef openshift fill:#1a73e8,stroke:#0d47a1,color:white
    classDef data fill:#00897b,stroke:#004d40,color:white
    classDef gitops fill:#7b1fa2,stroke:#4a148c,color:white
    classDef external fill:#f5f5f5,stroke:#9e9e9e,color:#333
    classDef storage fill:#e8eaf6,stroke:#5c6bc0,color:#333

    class Route,LR,Svc,InitC,CM openshift
    class PG,OS data
    class Argo,AppSet gitops
    class GH,OCI,Releases external
    class PVC_LR,PVC_PG,PVC_OS storage
